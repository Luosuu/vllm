# Copy this file to ~/.config/llmprof-ae.env on the reviewer access host.
# The access-host VM identity supplies Nebius authentication. Keep credentials
# out of this file. NEBIUS_PROFILE is only needed for non-VM deployments.

export ARTIFACT_REPOSITORY=/opt/llmprof-ae/vllm
export ARTIFACT_COMMIT=<final-40-character-git-commit>
export VLLM_REPO_URL=https://github.com/Luosuu/vllm.git

export NEBIUS_IMAGE=docker.io/vllm/vllm-openai@sha256:<amd64-image-digest>
export NEBIUS_VOLUME_SOURCE=<storage-bucket-or-filesystem-id>
export NEBIUS_STORAGE_MODE=object
export NEBIUS_BUCKET_NAME=<storage-bucket-name>
export NEBIUS_REGION=eu-north1

export NEBIUS_PARENT_ID=<project-id>
export NEBIUS_SUBNET_ID=<subnet-id>
export NEBIUS_PLATFORM=gpu-h100-sxm
export NEBIUS_PRESET=8gpu-128vcpu-1600gb
export NEBIUS_DISK_SIZE=1Ti
export NEBIUS_SHM_SIZE=64Gi
export NEBIUS_JOB_TIMEOUT=24h
export NEBIUS_SYNC_INTERVAL=300

# Set only when the selected model or image requires a MysteryBox secret.
# export NEBIUS_HF_SECRET=<secret-selector>
# export NEBIUS_REGISTRY_SECRET=<secret-selector>
